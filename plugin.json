{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pencil",
  "version": "0.7.1",
  "description": "Persistent Pencil editor with a native Codex view and shared per-session engine.",
  "author": {
    "name": "Julien M"
  },
  "license": "MIT",
  "keywords": [
    "pencil",
    "pen",
    "design",
    "side-panel"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Pencil",
        "shortDescription": "Persistent design sessions",
        "longDescription": "Edit .pen documents in Codex. Agents keep working with the panel closed; explicitly close a session to save and release its editor.",
        "developerName": "Julien M",
        "category": "Productivity",
        "capabilities": [
          "Interactive",
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "Ouvrir ce fichier .pen dans Pencil"
        ]
      }
    }
  }
}
